# Copy to .env and fill in. Never commit .env.
DOMAIN=club.example.gr
APP_URL=https://club.example.gr

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tennis:change-me@db:5432/tennis

# Generate each with: openssl rand -base64 32
AUTH_SECRET=
QR_SECRET=

# Used once by the seed script to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing email for password resets. On Hostinger: create a mailbox in hPanel
# (Emails) and use its SMTP details (host smtp.hostinger.com, port 465).
# Leave SMTP_HOST empty in dev and the reset link is printed to the server console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@example.gr
SMTP_PASS=
SMTP_FROM="Tennis Club <no-reply@example.gr>"
